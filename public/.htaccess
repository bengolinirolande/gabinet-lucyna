# Production Apache configuration for grochowskapsycholog.pl on OVH Hosting
Options -Indexes
DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow Let's Encrypt / OVH ACME HTTP-01 domain validation without redirects
  RewriteRule ^\.well-known/ - [L]

  # Enforce HTTPS and canonical non-www ONLY on the production domain
  # (keeps temporary grochol.cluster129.hosting.ovh.net preview working cleanly during DNS propagation)
  RewriteCond %{HTTP_HOST} ^www\.grochowskapsycholog\.pl$ [NC]
  RewriteRule ^ https://grochowskapsycholog.pl%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^grochowskapsycholog\.pl$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://grochowskapsycholog.pl%{REQUEST_URI} [R=301,L]

  # Never rewrite PHP API endpoints
  RewriteRule ^api/ - [L]

  # Serve pre-rendered static SEO HTML entry points cleanly without trailing-slash redirect loops
  RewriteRule ^terapia/?$ /terapia/index.html [L]
  RewriteRule ^o-mnie/?$ /o-mnie/index.html [L]
  RewriteRule ^gabinety/?$ /gabinety/index.html [L]
  RewriteRule ^(cennik|kontakt)/?$ /gabinety [R=301,L]

  # Serve existing static files directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Unknown routes -> custom 404 page (prevents soft-404 SEO issues)
  ErrorDocument 404 /404.html
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Long-lived immutable cache for hashed Vite bundles and compressed local images
  <FilesMatch "\.(js|css|svg|jpg|jpeg|png|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
